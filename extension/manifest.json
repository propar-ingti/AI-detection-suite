{
  "manifest_version": 3,

  "name": "AI Detector",

  "version": "1.0",

  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}